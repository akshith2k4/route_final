    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:hotels": "tsx --env-file=.env.local scripts/seed-hotels.ts",
    "db:seed:facilities": "tsx --env-file=.env.local scripts/seed-facilities.ts",
    "db:seed:plan": "tsx --env-file=.env.local scripts/seed-plan.ts",
    "db:studio": "drizzle-kit studio",
